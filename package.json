{
  "name": "afrobeautymarket-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Afroé beauty marketplace — native iOS + Android shell (Capacitor) wrapping app.afroe.studio",
  "scripts": {
    "build": "node -e \"if(!require('fs').existsSync('www/index.html')){process.exit(1)}\" && echo \"Using prebuilt static webDir: www\"",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "copy": "cap copy",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor '#A11A2E' --iconBackgroundColorDark '#1A1A18' --splashBackgroundColor '#FAF7F2' --splashBackgroundColorDark '#1A1A18'"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "typescript": "^5.6.0"
  }
}
